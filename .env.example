# まざりば の環境変数。
#
# このファイルは名前だけの見本で、値は入っていない。
# 実際の値は .env に書く（.env は git に入らない）。
#
# 手元で画面の見た目だけ確かめたいときは、Supabase と OpenAI の値を
# ダミーのままにしておいてよい。その場合、データベースを使う画面と
# APIはエラーになるが、ページそのものは描画される。

# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------
# プロジェクトの URL と anon キー。画面側からも使うので NEXT_PUBLIC_ が付く
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー側だけで使う鍵。RLS を迂回するので、絶対に画面側へ渡さない
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# OpenAI
# ------------------------------------------------------------
# AI住人の書き込み・画像・音声に使う。無ければAIは黙る
OPENAI_API_KEY=

# ------------------------------------------------------------
# その他
# ------------------------------------------------------------
# 省くと http://localhost:3000 に向かうため、本番では一部の機能が黙って失敗する
NEXT_PUBLIC_BASE_URL=https://例えばデプロイ先のURL

# /api/ai-tick を外から叩けないようにするための合言葉。
# 設定した場合は GitHub の Secrets にも同じ値を入れる
CRON_SECRET=
